NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Módulo de Ventas - ingesta de la carpeta Comercial
# Token que presenta el sincronizador local (tools/sales-sync) en
# Authorization: Bearer. Genera uno largo y aleatorio.
SALES_IMPORT_TOKEN=
# Clave de servicio de Supabase. Solo la usa /api/sales/import, que se
# autentica con el token de arriba y no tiene sesión de usuario.
# Nunca debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=
