# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# El sincronizador de ventas tiene su propio paquete en tools/sales-sync
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Archivos de trabajo local: manifiestos de ingesta, semillas generadas y
# cualquier extracto con precios de clientes. No deben salir del equipo.
/.local/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example


# vercel & firebase
.vercel
.firebase
firebase-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials & keys
credentials.json
*.key
.credentials
